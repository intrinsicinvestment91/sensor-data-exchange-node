{
  "permissions": {
    "allow": [
      "Bash(python*)",
      "Bash(pytest*)",
      "Bash(pip*)",
      "Bash(cargo*)",
      "Bash(docker*)",
      "Bash(docker-compose*)",
      "Bash(make*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git add*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(uvicorn*)",
      "Bash(mkdocs*)",
      "Bash(find*)",
      "Bash(grep*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | { read -r f; echo \"$f\" | grep -qE '\\.py$' && python -m py_compile \"$f\" 2>&1 && echo \"syntax ok\" || true; }",
            "timeout": 15,
            "statusMessage": "Checking Python syntax..."
          }
        ]
      }
    ]
  }
}
