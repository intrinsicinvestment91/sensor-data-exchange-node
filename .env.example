LNBITS_URL=https://your-lnbits-instance.com
LNBITS_API_KEY=your-lnbits-api-key
SENSOR_TYPE=temperature
PRICE_SATS=150
USE_MOCK_SENSOR=true
SDEN_HOST=0.0.0.0
SDEN_PORT=8080
AUDIT_DB_PATH=audit.db
INVOICE_EXPIRY_SECS=3600
# Identity persistence — one of:
#   DID_KEY_PATH: path to PEM file (generated on first boot, reloaded on restart)
#   DID_PRIVATE_KEY_PEM: full PEM string (preferred for containers / secrets managers)
DID_KEY_PATH=identity.pem
# DID_PRIVATE_KEY_PEM=
